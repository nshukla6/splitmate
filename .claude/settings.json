{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/log-bash-command.sh\"",
            "timeout": 2,
            "silent": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/log-user-prompt.sh\"",
            "timeout": 2,
            "silent": true
          }
        ]
      }
    ]
  },
  "description": "Logging hooks: bash commands and user prompts with timestamps and session tracking"
}
